{
  "name": "cardtrade",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @cardtrade/db db:generate",
    "db:migrate": "pnpm --filter @cardtrade/db db:migrate",
    "db:seed": "pnpm --filter @cardtrade/db db:seed",
    "server": "pnpm --filter @cardtrade/server dev",
    "app": "pnpm --filter @cardtrade/mobile-web start",
    "web": "pnpm --filter @cardtrade/mobile-web web"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
